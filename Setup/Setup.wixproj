<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- WiX v3 is not assumed to be installed system-wide. WixBinDir points at its
       bin directory and comes either from the environment (setx WixBinDir ...)
       or from the command line (/p:WixBinDir=...). This target only exists so
       that a missing value fails with a sentence instead of an import error
       pointing at \Wix.targets - when WixBinDir is set, Wix.targets defines
       Build and this one is replaced. -->
  <Target Name="Build" Condition=" '$(WixBinDir)' == '' ">
    <Error Text="WixBinDir is not set. Point it at the WiX v3 bin directory, e.g. setx WixBinDir D:\path\to\wix, or pass /p:WixBinDir=D:\path\to\wix." />
  </Target>

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProductVersion>3.14</ProductVersion>
    <ProjectGuid>1ec4555e-aeb5-4615-84f4-3604734337f0</ProjectGuid>
    <SchemaVersion>2.0</SchemaVersion>
    <OutputName>WinAppleKey-Setup</OutputName>
    <OutputType>Package</OutputType>

    <!-- The INF and the .sys use four fields and start at zero (0.1.1.11). The
         MSI gets the three trailing ones (1.1.11), because MSI only ever looks at
         three - the leading zero just says "this is not a commercially released
         product". Bump both here and in WinAppleKey.inf / resource.rc. -->
    <Version>1.1.11</Version>

    <WixInstallPath Condition=" '$(WixBinDir)' != '' ">$(WixBinDir)</WixInstallPath>
    <WixExtDir Condition=" '$(WixBinDir)' != '' ">$(WixBinDir)</WixExtDir>

    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))\</RepoRoot>
    <DriverOut>$(RepoRoot)WinAppleKey\x64\$(Configuration)\WinAppleKey\</DriverOut>
    <CertOut>$(RepoRoot)WinAppleKey\x64\$(Configuration)\</CertOut>
    <ToolOut>$(RepoRoot)Setup\x64\$(Configuration)\</ToolOut>

    <OutputPath>$(RepoRoot)Setup\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(RepoRoot)Setup\obj\$(Configuration)\wix\</IntermediateOutputPath>
    <DefineSolutionProperties>false</DefineSolutionProperties>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>DriverOut=$(DriverOut);CertOut=$(CertOut);ToolOut=$(ToolOut);Version=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>

  <ItemGroup>
    <WixExtension Include="WixDifxAppExtension">
      <HintPath>$(WixBinDir)\WixDifxAppExtension.dll</HintPath>
      <Name>WixDifxAppExtension</Name>
    </WixExtension>
    <WixExtension Include="WixIIsExtension">
      <HintPath>$(WixBinDir)\WixIIsExtension.dll</HintPath>
      <Name>WixIIsExtension</Name>
    </WixExtension>
    <WixExtension Include="WixUIExtension">
      <HintPath>$(WixBinDir)\WixUIExtension.dll</HintPath>
      <Name>WixUIExtension</Name>
    </WixExtension>
  </ItemGroup>

  <ItemGroup>
    <WixLibrary Include="difxapp_x64">
      <HintPath>$(WixBinDir)\difxapp_x64.wixlib</HintPath>
      <Name>difxapp_x64</Name>
    </WixLibrary>
  </ItemGroup>

  <Import Project="$(WixBinDir)\Wix.targets" Condition=" '$(WixBinDir)' != '' " />
</Project>
